    "@xunlei-open/dlsdk-native-linux-x64": "1.0.0"
  },
  "devDependencies": {
    "@rspack/cli": "^1.5.0",
    "@rspack/core": "^1.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
